generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Tabela 'User' (MANTIDA SEM ALTERAÇÕES NESTA SEÇÃO)
model User {
  id     Int    @id @default(autoincrement())
  nome   String @db.VarChar(50)
  email  String @unique @db.VarChar(100)
  senha  String @db.VarChar(100)
  foto   String? @db.VarChar(255)
  acesso String @default("user") @db.VarChar(5) 
  ativo  Boolean @default(true) @db.Bit 

  posts    Post[]
  coments  Coment[]
  
  @@map("users") 
}

// Tabela 'Post'
model Post {
  idPost    Int      @id @default(autoincrement())
  region    String   @db.VarChar(100)
  content   String   @db.VarChar(300)
  createdAt DateTime @default(now()) @map("createdAt")

  // Relacionamento com User: Mantenha Cascade para garantir que posts sejam deletados
  Users_id  Int      @map("Users_id")
  user      User     @relation(fields: [Users_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  coments   Coment[]

  @@map("post")
}

// Tabela 'coments' (Comentários)
model Coment {
  idComents Int      @id @default(autoincrement())
  content   String   @db.VarChar(300)
  createdAt DateTime @default(now()) @map("createdAt")

  // 1. Relacionamento com User: Mantenha Cascade
  Users_id  Int      @map("Users_id")
  user      User     @relation(fields: [Users_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // 2. Relacionamento com Post: QUEBRE O LOOP AQUI!
  // Se o Post for deletado (por ação direta ou via User->Post), os comentários
  // devem ser tratados pelo banco de dados ou pelo código de forma explícita.
  // Definindo como NoAction, o Prisma não vê mais o loop de exclusão.
  Post_idPost Int      @map("Post_idPost")
  post        Post     @relation(fields: [Post_idPost], references: [idPost], onDelete: NoAction, onUpdate: NoAction) 
  
  @@map("coments")
}